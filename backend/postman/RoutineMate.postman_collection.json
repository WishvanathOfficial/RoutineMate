        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Reads the refresh-token cookie set by Login/Register, rotates it, and returns a new access token. Postman's cookie jar sends the cookie automatically as long as Login/Register ran first in this session.",
