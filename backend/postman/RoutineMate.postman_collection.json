                "login"
              ]
            },
            "description": "Issues a fresh access + refresh token pair. Run this first if the seeded demo user already exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@routinemate.app\",\n  \"password\": \"Demo@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
