NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=routinemate
DB_USER=root
DB_PASSWORD=replace-with-database-password

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# CORS — the Vite dev server origin
CORS_ORIGIN=http://localhost:5173

# RESEND
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# Google OAuth verification for the web sign-in flow
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id

# Google Calendar OAuth (create a web OAuth client and register this exact callback URL)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/calendar-sync/oauth/callback
CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Billing (leave blank for development-safe configuration_required responses)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
